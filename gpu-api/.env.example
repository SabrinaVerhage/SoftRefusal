# Non-secret configuration. Never add actual tokens here.
SOFT_REFUSAL_DATA=/workspace/soft-refusal/runtime
SOFT_REFUSAL_AUTH_FILE=/workspace/soft-refusal/secrets/auth.json
HF_HOME=/workspace/huggingface
SOFT_REFUSAL_QUEUE_LIMIT=10
SOFT_REFUSAL_JOB_TIMEOUT=900
SOFT_REFUSAL_QUEUE_TIMEOUT=1800
SOFT_REFUSAL_IDLE_UNLOAD=120
# Enable only after model download + the neutral rehearsal have passed.
SOFT_REFUSAL_ENABLE_HERMES=0
# Optional, explicit BF16 CPU offload for FLUX. No quantization is supported.
SOFT_REFUSAL_FLUX_OFFLOAD=0
# Gate submissions until the operator has resolved the applicable use scope.
SOFT_REFUSAL_ACCEPT_REQUESTS=0
# Exact website origins, comma separated; empty disables cross-origin access.
SOFT_REFUSAL_ORIGINS=
# Set only to an inspected, public-assets-only copy of the existing website.
SOFT_REFUSAL_WEB_ROOT=
