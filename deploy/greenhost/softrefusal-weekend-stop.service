[Unit]
Description=Stop the approved Soft Refusal weekend A40
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/softrefusal-weekend-stop.py
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Restart=on-failure
RestartSec=30s
TimeoutStartSec=60s
